; =============================================================================
; yoy0.ty v0.4 — argv-aware self-hosting compiler (MVP: copy input.ty → output.exe)
; =============================================================================
;
; Status: argv parser + H_50 + H_51 call (file copy only).
; Real v0.4 needs H_01/H_30 (scanner + emitter) re-added.
;
; Note: each 00 00 A0 line emits ONE x86 byte. Multiple A0 per line is
; treated as multi-arg, only first arg emitted.
; =============================================================================

; -----------------------------------------------------------------------------
; H_00: ENTRY
; -----------------------------------------------------------------------------
00 00 40 00

; Save callee-saved (H_50/H_51 clobber r12/r13/r14)
; push r12
00 00 A0 41
00 00 A0 54
; push r13
00 00 A0 41
00 00 A0 55
; push r14
00 00 A0 41
00 00 A0 56
; push rbx
00 00 A0 53
; push r15
00 00 A0 41
00 00 A0 57
; push rsi
00 00 A0 56

; sub rsp, 0x1000
00 00 A0 48
00 00 A0 81
00 00 A0 EC
00 00 A0 00
00 00 A0 10
00 00 A0 00
00 00 A0 00

; lea r15, [rsp+0x800]
00 00 A0 48
00 00 A0 8D
00 00 A0 BC
00 00 A0 24
00 00 A0 00
00 00 A0 08
00 00 A0 00
00 00 A0 00

; mov rsi, [rdi]  — rsi = PSTR cmdline (writable, user-mode heap)
00 00 A0 48
00 00 A0 8B
00 00 A0 37

; Copy cmdline to stack at [rsp+0x100] using mov/inc loop (safe copy avoids rep movsb issues)
; lea rdi, [rsp+0x100]  ; 48 8D BC 24 00 01 00 00
00 00 A0 48
00 00 A0 8D
00 00 A0 BC
00 00 A0 24
00 00 A0 00
00 00 A0 01
00 00 A0 00
00 00 A0 00
; .copy_loop: mov al, [rsi]  ; 8A 06 (2B)
00 00 A0 8A
00 00 A0 06
; mov [rdi], al  ; 88 07 (2B)
00 00 A0 88
00 00 A0 07
; test al, al  ; 84 C0 (2B)
00 00 A0 84
00 00 A0 C0
; jz .copy_done  ; 74 02 (2B)
00 00 A0 74
00 00 A0 02
; inc rsi  ; 48 FF C6 (3B)
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; inc rdi  ; 48 FF C7 (3B)
00 00 A0 48
00 00 A0 FF
00 00 A0 C7
; jmp .copy_loop  ; EB F0 (target 0, disp = 0-16 = -16)
00 00 A0 EB
00 00 A0 F0
; .copy_done: ; reset rsi = rsp+0x100 (start of copy in stack)
00 00 A0 48
00 00 A0 8D
00 00 A0 B4
00 00 A0 24
00 00 A0 00
00 00 A0 01
00 00 A0 00
00 00 A0 00

; === Argv parser (raw x86, 38 bytes): scan+null-term spaces in stack copy ===
; Scan loop 0: find space after argv[0], null-terminate it
; offset 0: cmp byte [rsi], 0x20  ; 80 3E 20  (3B)
00 00 A0 80
00 00 A0 3E
00 00 A0 20
; offset 3: je .null0  (target 10, disp = 10-5 = 5 = 0x05)
00 00 A0 74
00 00 A0 05
; offset 5: inc rsi  ; 48 FF C6  (3B)
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 8: jmp .scan0  (target 0, disp = 0-10 = -10 = 0xF6)
00 00 A0 EB
00 00 A0 F6
; offset 10: .null0: mov byte [rsi], 0  ; C6 06 00 (3B)
00 00 A0 C6
00 00 A0 06
00 00 A0 00
; offset 13: inc rsi  ; 48 FF C6 (3B) — skip past the null, now at argv[1]
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 16: .argv1_start: mov r12, rsi  ; 49 89 F4 (3B)
00 00 A0 49
00 00 A0 89
00 00 A0 F4
; Scan loop 1: find space after argv[1], null-terminate it
; Also check for null (end of cmdline — no argv[2])
; offset 19: cmp byte [rsi], 0x20  ; 80 3E 20 (3B)
00 00 A0 80
00 00 A0 3E
00 00 A0 20
; offset 22: je .null1  (target 34, disp = 34-24 = 10 = 0x0A)
00 00 A0 74
00 00 A0 0A
; offset 24: cmp byte [rsi], 0  ; 80 3E 00 (3B)
00 00 A0 80
00 00 A0 3E
00 00 A0 00
; offset 27: je .no_argv2  (target 40, disp = 40-29 = 11 = 0x0B)
00 00 A0 74
00 00 A0 0B
; offset 29: inc rsi  ; 48 FF C6 (3B)
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 32: jmp .scan1  (target 19, disp = 19-34 = -15 = 0xF1)
00 00 A0 EB
00 00 A0 F1
; offset 34: .null1: mov byte [rsi], 0  ; C6 06 00 (3B)
00 00 A0 C6
00 00 A0 06
00 00 A0 00
; offset 37: inc rsi  ; 48 FF C6 (3B) — skip past null, now at argv[2]
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 40: .no_argv2: mov r13, rsi  ; 49 89 F5 (3B)
00 00 A0 49
00 00 A0 89
00 00 A0 F5

; === H_50: load input.ty (rsi=argv[1] = r12) ===
00 00 A0 4C
00 00 A0 89
00 00 A0 E6
00 00 50 00 00 00
; After: rax = contentBuf, rdx = fileSize

; === H_51: write to argv[1] (test: self-copy) ===
; Don't change rsi, use r12 (argv[1])
00 00 A0 4C
00 00 A0 89
00 00 A0 E6
; mov r8, rdx  ; r8 = fileSize
00 00 A0 49
00 00 A0 89
00 00 A0 C2
; mov rdx, rax  ; rdx = contentBuf
00 00 A0 48
00 00 A0 89
00 00 A0 C2
00 00 51 00 00 00
; DEBUG: read first byte of rsi
00 00 A0 31
00 00 A0 C0
00 00 A0 8A
00 00 A0 06
00 00 FF

; === Cleanup ===
; add rsp, 0x1000
00 00 A0 48
00 00 A0 81
00 00 A0 C4
00 00 A0 00
00 00 A0 10
00 00 A0 00
00 00 A0 00
; pop rsi
00 00 A0 5E
; pop r15
00 00 A0 41
00 00 A0 5F
; pop rbx
00 00 A0 5B
; pop r14
00 00 A0 41
00 00 A0 5E
; pop r13
00 00 A0 41
00 00 A0 5D
; pop r12
00 00 A0 41
00 00 A0 5C
00 00 FF
