; =============================================================================
; yoy0.ty v0.4 — argv-aware self-hosting compiler (MVP: copy input.ty → output.exe)
; =============================================================================
;
; Status: argv parser + H_50 + H_51 call (file copy only).
; Real v0.4 needs H_01/H_30 (scanner + emitter) re-added.
;
; Note: each 00 00 A0 line emits ONE x86 byte. Multiple A0 per line is
; treated as multi-arg, only first arg emitted.
; =============================================================================

; -----------------------------------------------------------------------------
; H_00: ENTRY
; -----------------------------------------------------------------------------
00 00 40 00

; Save callee-saved (H_50/H_51 clobber r12/r13/r14)
; push r12
00 00 A0 41
00 00 A0 54
; push r13
00 00 A0 41
00 00 A0 55
; push r14
00 00 A0 41
00 00 A0 56
; push rbx
00 00 A0 53
; push r15
00 00 A0 41
00 00 A0 57
; push rsi
00 00 A0 56

; sub rsp, 0x1000
00 00 A0 48
00 00 A0 81
00 00 A0 EC
00 00 A0 00
00 00 A0 10
00 00 A0 00
00 00 A0 00

; lea r15, [rsp+0x800]
00 00 A0 48
00 00 A0 8D
00 00 A0 BC
00 00 A0 24
00 00 A0 00
00 00 A0 08
00 00 A0 00
00 00 A0 00

; mov rsi, [rdi]
00 00 A0 48
00 00 A0 8B
00 00 A0 37

; Copy cmdline to stack at [rsp+0x900] (safe scratch in our 0x1000 frame)
; Use rsi = cmdline, rdi = rsp+0x900, rcx = 0x400 bytes
; lea rdi, [rsp+0x900]  ; 48 8D BC 24 00 09 00 00
00 00 A0 48
00 00 A0 8D
00 00 A0 BC
00 00 A0 24
00 00 A0 00
00 00 A0 09
00 00 A0 00
00 00 A0 00
; mov ecx, 0x400  ; B9 00 04 00 00
00 00 A0 B9
00 00 A0 00
00 00 A0 04
00 00 A0 00
00 00 A0 00
; rep movsb  ; F3 A4
00 00 A0 F3
00 00 A0 A4
; rsi = rsp+0x900 (start of copy in stack)
00 00 A0 48
00 00 A0 8D
00 00 A0 B4
00 00 A0 24
00 00 A0 00
00 00 A0 09
00 00 A0 00
00 00 A0 00

; === Argv parser (raw x86, 72 bytes) ===
; offset 0: movzx eax, byte [rsi]  ; 0F B6 06
00 00 A0 0F
00 00 A0 B6
00 00 A0 06
; offset 3: test al, al  ; 84 C0
00 00 A0 84
00 00 A0 C0
; offset 5: jz .done (target 72, disp = 65 = 0x41)
00 00 A0 74
00 00 A0 41
; offset 7: cmp al, 0x20  ; 3C 20
00 00 A0 3C
00 00 A0 20
; offset 9: je .skip1_end (target 17, disp = 6 = 0x06)
00 00 A0 74
00 00 A0 06
; offset 11: inc rsi  ; 48 FF C6
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 14: jmp .skip1 (target 0, disp = -16 = 0xF0)
00 00 A0 EB
00 00 A0 F0
; offset 16: .skip1_end: movzx eax, byte [rsi]
00 00 A0 0F
00 00 A0 B6
00 00 A0 06
; offset 19: cmp al, 0x20
00 00 A0 3C
00 00 A0 20
; offset 21: jne .argv1_start (target 30, disp = 7 = 0x07)
00 00 A0 75
00 00 A0 07
; offset 23: inc rsi
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 26: jmp .skip1_end (target 16, disp = -12 = 0xF4)
00 00 A0 EB
00 00 A0 F4
; offset 28: .argv1_start: mov r12, rsi  ; 49 89 F4
00 00 A0 49
00 00 A0 89
00 00 A0 F4
; offset 31: .end2: movzx eax, byte [rsi]
00 00 A0 0F
00 00 A0 B6
00 00 A0 06
; offset 34: test al, al
00 00 A0 84
00 00 A0 C0
; offset 36: jz .argv2_done (target 72, disp = 34 = 0x22)
00 00 A0 74
00 00 A0 22
; offset 38: cmp al, 0x20
00 00 A0 3C
00 00 A0 20
; offset 40: je .skip3 (target 53, disp = 11 = 0x0B)
00 00 A0 74
00 00 A0 0B
; offset 42: inc rsi (skip space, do NOT null-terminate — cmdline is OS read-only!)
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 45: jmp .end2 (target 31, disp = 31-47 = -16 = 0xF0)
00 00 A0 EB
00 00 A0 F0
; offset 47: .skip3: movzx eax, byte [rsi]
00 00 A0 0F
00 00 A0 B6
00 00 A0 06
; offset 50: cmp al, 0x20
00 00 A0 3C
00 00 A0 20
; offset 52: jne .argv2_start (target 60, disp = 60-54 = 6 = 0x06)
00 00 A0 75
00 00 A0 06
; offset 54: inc rsi
00 00 A0 48
00 00 A0 FF
00 00 A0 C6
; offset 57: jmp .skip3 (target 47, disp = 47-59 = -12 = 0xF4)
00 00 A0 EB
00 00 A0 F4
; offset 59: .argv2_start: mov r13, rsi  ; 49 89 F5
00 00 A0 49
00 00 A0 89
00 00 A0 F5
; offset 62: .argv2_done:

; === H_50: load input.ty (rsi=argv[1] = r12) ===
00 00 A0 4C
00 00 A0 89
00 00 A0 E6
00 00 50 00 00 00
; After: rax = contentBuf, rdx = fileSize

; === H_51: write output.exe (rsi=argv[2] = r13) ===
00 00 A0 4C
00 00 A0 89
00 00 A0 EE
; mov r8, rdx  ; r8 = fileSize
00 00 A0 49
00 00 A0 89
00 00 A0 C2
; mov rdx, rax  ; rdx = contentBuf
00 00 A0 48
00 00 A0 89
00 00 A0 C2
00 00 51 00 00 00

; === Cleanup ===
; add rsp, 0x1000
00 00 A0 48
00 00 A0 81
00 00 A0 C4
00 00 A0 00
00 00 A0 10
00 00 A0 00
00 00 A0 00
