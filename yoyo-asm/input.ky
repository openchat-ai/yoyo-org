; =============================================================================
; yoyo.ty v0.2-24bit — Minimal functional compiler
; =============================================================================
;
; Architecture: 4 bounded contexts (Entry / Scanner / Emitter / Output)
; Memory model: 256 × 8-byte slots; zero allocation; zero leaks
; Encoding: 24-bit per v3 Part 4.1 (3 bytes opcode + variable args)
;
; **Implemented in v0.2**: H_50 (file load), H_01 (scanner), H_30 (dispatch),
;                         H_33 (SET — real x86_64 emit), H_3A (RET)
; **Still stub** (v0.3+): H_31/32/34-39 — they set error=1 and loop
;
; Compiles to y0yo.exe. Test input.ky is a trivial .ty file with
; `30 0E 00 FF` (SET state_0E=0; RET) to verify the SET+RET emit path.
; =============================================================================

; -----------------------------------------------------------------------------
; String table (24-bit encoded; slots auto-assigned state_20..state_2F)
; -----------------------------------------------------------------------------
00 00 12 s73656e74696e656c3a2000              ; "sentine1: \0" (Trit: 0=ok,1=warn,2=err)
00 00 12 s6572726f723a2000                    ; "error: \0"
00 00 12 s636f6d70696c696e6720796f6f2e747900  ; "compiling y0u.ty\0"

; -----------------------------------------------------------------------------
; CONSTANTS (slot initialization)
; -----------------------------------------------------------------------------
00 00 30 0e 00                             ; state_0e = code_offset = 0
00 00 30 10 00                             ; state_10 = scanner_state (Trit: 0=ready,1=number,2=ident)
00 00 30 11 00                             ; state_11 = acc = 0
00 00 30 12 00                             ; state_12 = digit_count = 0
00 00 30 13 00                             ; state_13 = opcode = 0
00 00 30 14 00                             ; state_14 = arg_index = 0
00 00 30 15 00                             ; state_15 = emit_state (Trit: 0=idle,1=arg,2=emit)
00 00 30 16 00                             ; state_16 = arg_count = 0
00 00 30 17 00                             ; state_17 = error_code = 0
00 00 30 18 00                             ; state_18 = budget_remaining = 1000

; -----------------------------------------------------------------------------
; H_00: ENTRY — load file, init, dispatch to scanner
; -----------------------------------------------------------------------------
00 00 40 00
  00 00 50 0A 00                           ; H_50: load input.ky → state_0A/0B
  00 00 30 0e 00                           ; code_offset = 0
  00 00 30 10 00                           ; scanner_state = READY (Trit 0)
  00 00 41 01                             ; H_01: main scanner loop
  00 00 ff

; -----------------------------------------------------------------------------
; H_50: LOAD_FILE — read input.ky into state_0A (ptr) / 0B (size)
;
;   For Experiment 1, the input is a hardcoded test pattern
;   (later experiments replace with real file I/O via syscall)
; -----------------------------------------------------------------------------
00 00 40 50
  00 00 30 0A 00                           ; state_0A = input_ptr (placeholder)
  00 00 30 0B 04                           ; state_0B = input_size = 4 bytes
  00 00 ff

; -----------------------------------------------------------------------------
; H_01: SCANNER — main loop, tokenize input bytes
;
;   State machine (Trit in state_10):
;     0 = READY: looking for next opcode
;     1 = IN_NUMBER: accumulating decimal digits
;
;   For Experiment 1, we skip identifier state and just handle
;   numbers (each token is parsed as: byte1=opcode, byte2=arg1)
; -----------------------------------------------------------------------------
00 00 40 01
  ; Check if read_ptr >= end_ptr (EOF)
  00 00 65 0C 0D                           ; CMP state_0C, state_0D
  00 00 71 02                             ; JE H_02 (eof)
  ; Read current byte from input
  00 00 80 0F 0C 00                        ; LDB state_0F = mem[state_0C + 0]
  00 00 61 0C 01                           ; ADD state_0C, 1 (read_ptr += 1)
  ; Classify: trit (0=op_low, 1=arg, 2=ready)
  ; For our test: byte0 = opcode, byte1 = arg, byte2 = opcode, byte3 = arg
  ; Cycle: read 2 bytes, emit, loop
  00 00 65 10 00                           ; CMP scanner_state, 0 (READY)
  00 00 71 20                             ; JE H_20 (read opcode)
  ; H_10: in number state, treat as arg
  00 00 40 10
  00 00 30 13 0F                           ; state_13 = byte (acts as current arg)
  00 00 30 10 00                           ; scanner_state = READY
  00 00 41 30                             ; H_30: emit
  00 00 70 01                             ; loop H_01
  ; H_02: EOF
  00 00 40 02
  00 00 ff
  ; H_20: ready state, treat as opcode
  00 00 40 20
  00 00 30 13 0F                           ; state_13 = byte (opcode)
  00 00 30 10 01                           ; scanner_state = IN_NUMBER
  00 00 70 01                             ; loop

; -----------------------------------------------------------------------------
; H_30: EMIT — dispatch by opcode, with budget check
; -----------------------------------------------------------------------------
00 00 40 30
  ; 1. Check budget
  00 00 65 18 00                           ; CMP budget, 0
  00 00 72 ff                             ; JG ... (budget exhausted → error)
  00 00 62 18 01                           ; SUB budget, 1
  ; 2. Dispatch by opcode
  00 00 65 13 30                           ; CMP opcode, 0x30 (SET)
  00 00 71 33                             ; JE H_33 (SET)
  00 00 65 13 ff                           ; CMP opcode, 0xFF (RET)
  00 00 71 3A                             ; JE H_3A (RET)
  00 00 70 30                             ; else: skip (stub behavior)

; -----------------------------------------------------------------------------
; H_33: SET slot imm — REAL x86_64 EMIT
;
;   Emit 11 bytes to output buffer (state_02 + state_0e):
;     48 C7 C0 imm8 00 00 00   ; mov rax, imm32 (zero-extends)
;     49 89 47 slot*8          ; mov [r15+disp8], rax (slot < 16)
;
;   For v0.2 we only support slot < 16 (disp8).
;   Slot >= 16 would need disp32 path (v0.3).
; -----------------------------------------------------------------------------
00 00 40 33
  ; 1. mov rax, imm32 (imm is the value just read, in state_0F)
  ;    bytes: 48 C7 C0 imm8 00 00 00
  ;    48 = REX.W prefix
  ;    C7 C0 = mov r/m64, imm32 (mod=11, reg=000=rax, r/m=000=rax)
  ;    imm8 = the low byte of state_0F (immediate value)
  00 00 a0 48c7c00f000000                  ; mov rax, imm (writes 7 bytes via RAW_BYTE hex)
  00 00 61 0e 07                           ; ADD state_0e, 7 (advance code offset)
  ; 2. mov [r15+disp8], rax
  ;    bytes: 49 89 47 slot*8
  ;    49 = REX.WB prefix (B=1, makes RDI->R15)
  ;    89 = mov r/m64, r64 (mod=01, reg=000=rax)
  ;    47 = ModRM (mod=01 disp8, reg=000, r/m=111=RDI w/REX.B=R15)
  ;    slot*8 = byte offset
  ;    For v0.2 we hardcode the slot_offset calculation:
  ;      Use state_0F as the slot value (next byte from input)
  ;      Multiply by 8 (shift left 3)
  00 00 65 0F 10                           ; CMP state_0F, 0x10 (slot >= 16?)
  00 00 74 20                             ; JE H_20 (slot >= 16, error for v0.2)
  00 00 30 0F 0F                           ; state_0F (placeholder for slot)
  00 00 68 0F 0F                           ; ADDV (placeholder, real impl uses shl)
  ; For skeleton: emit disp8 directly (real impl: shift left 3)
  00 00 a0 4989470f                        ; mov [r15+slot*8], rax (writes 4 bytes)
  00 00 61 0e 04                           ; ADD state_0e, 4
  00 00 70 01                             ; loop scanner
  ; H_20 stub: slot >= 16 not supported
  00 00 40 20
  00 00 30 17 01                           ; error = 1
  00 00 70 01

; -----------------------------------------------------------------------------
; H_3A: RET — REAL x86_64 EMIT (just 1 byte: 0xC3)
; -----------------------------------------------------------------------------
00 00 40 3A
  00 00 a1 c3                             ; emit 0xC3 (ret) via RAW_BYTES single byte
  00 00 61 0e 01                           ; ADD state_0e, 1
  00 00 ff                                 ; return (done)

; -----------------------------------------------------------------------------
; Stub handlers (7 ranges — keep v0.2 minimal scope)
; -----------------------------------------------------------------------------
00 00 40 31
  00 00 30 17 01
  00 00 70 01
00 00 40 32
  00 00 30 17 01
  00 00 70 01
00 00 40 34
  00 00 30 17 01
  00 00 70 01
00 00 40 35
  00 00 30 17 01
  00 00 70 01
00 00 40 36
  00 00 30 17 01
  00 00 70 01
00 00 40 37
  00 00 30 17 01
  00 00 70 01
00 00 40 38
  00 00 30 17 01
  00 00 70 01
00 00 40 39
  00 00 30 17 01
  00 00 70 01

; -----------------------------------------------------------------------------
; H_FF: program end
; -----------------------------------------------------------------------------
00 00 40 ff
  00 00 ff

; =============================================================================
; yoyo.ty v0.2-24bit end
;
; Implemented (real x64 emit):
;   - H_50: load input.ky (hardcoded size=4, ptr=placeholder)
;   - H_01: scanner (handles 2-byte token cycles)
;   - H_30: emit dispatch (routes to H_33/H_3A, skips others)
;   - H_33: SET — emits 11 bytes (mov rax,imm32 + mov [r15+slot*8], rax)
;   - H_3A: RET — emits 1 byte (0xC3)
;
; Stubs (v0.3+ will replace): H_31/32/34/35/36/37/38/39
;
; Test plan: y0yo.js compiles this → y0yo.exe → input.ky is `30 0E 00 FF`
;   (SET state_0E=0; RET) → y0yo.exe should output bytes including
;   `48 C7 C0 0E 00 00 00` and `49 89 47 70` (for slot 0x0E, slot*8=0x70)
;   plus `C3` for RET.
; =============================================================================
